# FitnessForLovers Backend - Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
# Example: postgresql://user:password@localhost:5432/fitnessforlovers?schema=public
DATABASE_URL=

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Apple Sign In
# Get these from Apple Developer Console
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY= # Base64 encoded .p8 file content
APPLE_BUNDLE_ID=

# Redis (optional - for sessions, caching, rate limiting)
# REDIS_URL=redis://localhost:6379

# APNs Push Notifications (optional)
# Get these from Apple Developer Console
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY= # Base64 encoded .p8 file content
APNS_PRODUCTION=false

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000